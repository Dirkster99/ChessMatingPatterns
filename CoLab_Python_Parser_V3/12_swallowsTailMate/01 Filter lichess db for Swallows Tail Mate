e_name(square)})  # Store the position in algebraic notation\n","\n","    return positions\n","\n","def getPieceNameForType(piece_type):\n","  piece_name = 'unknown'\n","  piece_names = {\n","    chess.PAWN: \"Pawn\",\n","    chess.KNIGHT: \"Knight\",\n","    chess.BISHOP: \"Bishop\",\n","    chess.ROOK: \"Rook\",\n","    chess.QUEEN: \"Queen\",\n","    chess.KING: \"King\"\n","  }\n","\n","  return piece_names[piece_type]\n","\n","def getCheckingPieces():\n","  checking_pieces = []\n","\n","  # Check if the king is in check\n","  if board.is_check():\n","      # Get the list of checking moves (there can be more than one if double check)\n","      checking_squares = list(board.checkers())\n","\n","      # For each checking piece, identify its type and color\n","      for square in checking_squares:\n","          piece = board.piece_at(square)\n","          if piece:\n","              piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n","              piece_color = 'white' if piece.color == chess.WHITE else 'black'\n","\n","              x = int(chess.square_file(square))\n","              y = int(chess.square_rank(square))\n","\n","              # print(f\"Check by a {piece_color} {chess.piece_name(piece_type)} at square {chess.square_name(square)}\")\n","              checking_pieces.append({\"type\": piece_type,\n","                                      \"name\": getPieceNameForType(piece.piece_type),\n","                                      \"color\": piece_color,\n","                                      \"square\": chess.square_name(square),\n","                                      \"coord\": [x, y]})\n","\n","      return checking_pieces\n","\n","  return []\n","\n","\n","def getPieceAt(x:int, y:int):\n","\n","  if x < 0 or x > 7 or y < 0 or y > 7:\n","    return None\n","\n","  square = chess.square(x, y)\n","  piece = board.piece_at(square)\n","  if piece:\n","      piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n