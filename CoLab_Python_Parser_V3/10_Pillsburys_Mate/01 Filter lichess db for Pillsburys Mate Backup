match standard chess notation.\n","          x = int(chess.square_file(square))\n","          y = int(chess.square_rank(square))\n","          positions.append({\"coord\":[x, y], \"square\":chess.square_name(square)})  # Store the position in algebraic notation\n","\n","    return positions\n","\n","def getPieceNameForType(piece_type):\n","  piece_name = 'unknown'\n","  piece_names = {\n","    chess.PAWN: \"Pawn\",\n","    chess.KNIGHT: \"Knight\",\n","    chess.BISHOP: \"Bishop\",\n","    chess.ROOK: \"Rook\",\n","    chess.QUEEN: \"Queen\",\n","    chess.KING: \"King\"\n","  }\n","\n","  return piece_names[piece_type]\n","\n","def getCheckingPieces():\n","  checking_pieces = []\n","\n","  # Check if the king is in check\n","  if board.is_check():\n","      # Get the list of checking moves (there can be more than one if double check)\n","      checking_squares = list(board.checkers())\n","\n","      # For each checking piece, identify its type and color\n","      for square in checking_squares:\n","          piece = board.piece_at(square)\n","          if piece:\n","              piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n","              piece_color = 'white' if piece.color == chess.WHITE else 'black'\n","\n","              x = int(chess.square_file(square))\n","              y = int(chess.square_rank(square))\n","\n","              # print(f\"Check by a {piece_color} {chess.piece_name(piece_type)} at square {chess.square_name(square)}\")\n","              checking_pieces.append({\"type\": piece_type,\n","                                      \"name\": getPieceNameForType(piece.piece_type),\n","                                      \"color\": piece_color,\n","                                      \"square\": chess.square_name(square),\n","                                      \"coord\": [x, y]})\n","\n","      return checking_pieces\n","\n","  return []\n","\n","def is_square_light(square):\n","  \"\"\"\n","    Determine if a square on a chessboard is light or dark.\n","\n","    Usage:\n","    # Example usage\n","    square_a1 = chess.square(0, 0)  # a1\n","    square_h3 = chess.square(7, 2)  # h3\n","    print(is_square_light(square_a1))  # Output: False (dark)\n","    print(is_square_light(square_h3))  # Output: True (light)\n","  \"\"\"\n","  # Convert square to numeric values\n","  column = chess.square_file(square) + 1  # Convert to 1-8\n","  row = chess.square_rank(square) + 1      # Convert to 1-8\n","  return (column + row) % 2 == 1  # True for light, False for dark\n","\n","\n","\n","def get_opera_mate_bishop(checking_rooks_pos, king, puzzle_id):\n","  \"\"\"\n","    Determines if the current position represents an Opera mate, or not,\n","    using rooks that are checking the opposing king as a parameter.\n","  \"\"\"\n","\n","  opera_bishop = None\n","  for rook in checking_rooks_pos:\n","    delta_pos = [king[\"coord\"][0] - rook[\"coord\"][0], king[\"coord\"][1] - rook[\"coord\"][1]]\n","\n","    if abs(delta_pos[0]) == 1 or abs(delta_pos[1]) == 1:\n","      # indicates that the Rook is standing next to the king,\n","      # thus, needing a defense by the bishop\n","\n","      rook_square = is_square_light(chess.square(rook[\"coord\"][0], rook[\"coord\"][1]))\n","\n","      for bishop in bishops:\n","        bishop_square = is_square_light(chess.square(bishop[\"coord\"][0], bishop[\"coord\"][1]))\n","        if bishop_square == rook_square:\n","          bishop_pos = bishop[\"coord\"]\n","          delta_pos = [rook[\"coord\"][0] - bishop[\"coord\"][0], rook[\"coord\"][1] - bishop[\"coord\"][1]]\n","\n","          # Rook and Bishop are positioned in a diagonal line to each other\n","          if abs(delta_pos[0]) == abs(delta_pos[1]):\n","            step_x = 1 if bishop[\"coord\"][0] > rook[\"coord\"][0] else -1\n","            step_y = 1 if bishop[\"coord\"][1] > rook[\"coord\"][1] else -1\n","\n","            # Check each square along the diagonal path\n","            is_scanline = True\n","            for i in range(1, abs(delta_pos[0])):           # x_diff == delta_pos[0])\n","                scan_square = [bishop[\"coord\"][0] - i * step_x, bishop[\"coord\"][1] - i * step_y]\n","\n","                if board.piece_at(chess.square(scan_square[0],scan_square[1])) is not None:\n","                  is_scanline = False\n","                  break\n","\n","            if is_scanline is True:\n","              opera_bishop = bishop\n","\n","  return opera_bishop\n","\n","\n","def get_surrounding_empty_squares(king, _board):\n","    surrounding_squares = []\n","\n","    # Calculate the coordinates of the surrounding squares\n","    for dx in [-1, 0, 1]:\n","        for dy in [-1, 0, 1]:\n","            if (dx != 0 or dy != 0):  # Exclude the king's own position\n","                surrounding_square = [king[\"coord\"][0] + dx, king[\"coord\"][1] + dy]\n","\n","                # Check if the surrounding square is within bounds (0-7 for a standard chessboard)\n","                if 0 <= surrounding_square[0] <= 7 and 0 <= surrounding_square[1] <= 7:\n","                    surrounding_squares.append(surrounding_square)\n","\n","    # Determine if the surrounding squares are empty\n","    empty_squares = []\n","    for square in surrounding_squares:\n","        if _board.piece_at(chess.square(square[0],square[1])) is None:\n","            empty_squares.append(square)\n","\n","    return empty_squares  # Return the list of empty surrounding squares on the chess board\n"],"metadata":{"id":"pZUu-DDgo2z5","executionInfo":{"status":"ok","timestamp":1766096457036,"user_tz":-60,"elapsed":20,"user":{"displayName":"Dirkster9999 ___","userId":"14481456906440972157"}}},"execution_count":46,"outputs":[]},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"4IOSqSmP5hb-"}},{"cell_type":"code","source":["import pandas as pd\n","import chess\n","import numpy as np\n","from datetime import datetime, timedelta\n","import copy\n","\n","\n","def remove_bishop_and_checkmate(board, bishop_coords):\n","    # Create a deep copy of the board\n","    copied_board = copy.deepcopy(board)\n","\n","    # Remove the bishop from its coordinates\n","    x, y = bishop_coords\n","    piece_to_remove = copied_board.piece_at(chess.square(x, y))\n","\n","    if piece_to_remove and piece_to_remove.piece_type == chess.BISHOP:\n","        copied_board.remove_piece_at(chess.square(x, y))\n","\n","    # Check if the current position is checkmate\n","    return copied_board.is_checkmate()\n","\n","# Load CSV file into a DataFrame\n","df = pd.read_csv(filtered_output_file)\n","df['PatternMatch'] = False\n","df['Opera'] = False\n","df['Pillsburys'] = False\n","\n","df['puzzle_ref'] = 'https://lichess.org/training/' + df['PuzzleId']\n","\n","# Process each row using itertuples\n","line=0\n","matched_lines=0\n","start_time = datetime.now()\n","for row in df.itertuples(index=True):\n","\n","  line=row.Index\n","\n","  if (line % 100000) == 0:\n","    # Calculate the time delta\n","    time_delta = datetime.now() - start_time\n","    print(f\"{time_delta}: puzzles searched: {line} matches: {matched_lines}\")\n","\n","  #if df['PuzzleId'][line] != 'pSskg':\n","  #  line = line + 1\n","  #  continue\n","\n","  moves_to_apply = df['Moves'][line].split()\n","\n","  # Print the board position\n","  #print(board)\n","  #display(board)\n","  #print('Making moves')\n","  # Load the position from the FEN string\n","  board = chess.Board(df['FEN'][line])\n","\n","  our_color = None\n","  our_discovery = False\n","  opponent_color = None\n","  opponent_chess_color = None\n","  our_chess_color = None\n","  checking_rooks_pos = []\n","  checking_rook_is_Pillsbury = []\n","\n","  # Apply each move to the board\n","  move_count = 0\n","  # san_moves = []\n","  # chess_moves = []\n","\n","  i = 0\n","  for move in moves_to_apply:\n","    i = i + 1\n","\n","    chess_move = chess.Move.from_uci(move)   # Get Move object from UCI string\n","    # sample chess_moves: 'e5f4', 'a2a1q', 'g5g4', 'a6a7'\n","\n","    # print(f\"DEBUG: \")\n","    # print(f\"DEBUG: Making a move:{chess_move}\")\n","    # print(f\"DEBUG: Legal Move:{chess_move in board.legal_moves}\")\n","\n","    # Check if the move is legal before making it\n","    if chess_move in board.legal_moves:\n","        # chess_moves.append(move)\n","        # Get the piece at the source square\n","        piece_moved = board.piece_at(chess_move.from_square)\n","        piece_moved_color = \"white\" if piece_moved.color == chess.WHITE else \"black\"\n","\n","        if i == 1:                            # Determine who plays what color\n","          opponent_color = piece_moved_color\n","\n","          if opponent_color == \"white\":\n","            opponent_chess_color = chess.WHITE\n","            our_chess_color = chess.BLACK\n","            our_color = \"black\"\n","          else:\n","            opponent_chess_color = chess.BLACK\n","            our_chess_color = chess.WHITE\n","            our_color = \"white\"\n","\n","        board.push(chess_move)  # Make the move to evaluate current position\n","\n","  # Validate checking piece of the last move\n","  checking_pieces = getCheckingPieces()\n","  king = getPiecePositions(chess.KING, opponent_chess_color)[0]\n","\n","  if len(checking_pieces) > 0:\n","    # Source and destination squares in algebraic notation\n","    source_square = chess.square_name(chess_move.from_square)\n","    destination_square = chess.square_name(chess_move.to_square)\n","\n","    for checking_piece in checking_pieces:\n","      # A Pillsbury's mate requires a Rook to do the checking and a Bishop to limit the King\n","      # A Opera mate requires a Rook to do the checking and a Bishop to defend the Rook next to the King\n","      if checking_piece[\"color\"].lower() == our_color.lower():\n","        if checking_piece[\"type\"] == chess.ROOK:\n","          # Checking rook cannot be positioned next to king for Pillsbury's mate\n","          # but it must be positioned so for Opera Mate\n","          if abs(king[\"coord\"][0] - checking_piece[\"coord\"][0]) != 1 and \\\n","             abs(king[\"coord\"][1] - checking_piece[\"coord\"][1]) != 1:\n","             checking_rook_is_Pillsbury.append(True)\n","          else:\n","            checking_rook_is_Pillsbury.append(False)\n","\n","          checking_rooks_pos.append(checking_piece)\n","\n","  # This implies that we do not have a Bishop doing the final mating\n","  if len(checking_rooks_pos) == 0:\n","    continue\n","\n","  bishops = getPiecePositions(chess.BISHOP, our_chess_color)\n","  if len(bishops) == 0:\n","    continue\n","\n","  opera_bishop = get_opera_mate_bishop(checking_rooks_pos, king, df['PuzzleId'][line])\n","\n","  #if opera_bishop is not None:\n","  #  print(f\"DEBUG: Opera Bishop\")\n","  #  print(f\"DEBUG: Opera Bishop: {df['puzzle_ref'][line]} > {opera_bishop}\")\n","  #  print(f\"DEBUG: Opera Bishop\")\n","\n","  pillsbury_bishop = None\n","\n","  empty_king_squares = get_surrounding_empty_squares(king, board)\n","\n","  if len(empty_king_squares) == 0:\n","    continue\n","\n","  empty_rook_square_pos = []\n","  rook_pos_idx = -1\n","  for rook_pos in checking_rooks_pos:\n","    rook_pos_idx = rook_pos_idx + 1\n","    if checking_rook_is_Pillsbury[rook_pos_idx] is False:\n","      continue\n","\n","    if king['coord'][0] > rook_pos[\"coord\"][0]:\n","      empty_rook_square_pos.append([king[\"coord\"][0] - 1, king[\"coord\"][1]])\n","\n","    elif king['coord'][1] > rook_pos[\"coord\"][1]:\n","      empty_rook_square_pos.append([king[\"coord\"][0], king[\"coord\"][1] - 1 ])\n","\n","    if king['coord'][0] < rook_pos[\"coord\"][0]:\n","      empty_rook_square_pos.append([king[\"coord\"][0] + 1, king[\"coord\"][1]])\n","\n","    elif king['coord'][1] < rook_pos[\"coord\"][1]:\n","      empty_rook_square_pos.append([king[\"coord\"][0], king[\"coord\"][1] + 1 ])\n","\n","\n","  for bishop in bishops:\n"," 