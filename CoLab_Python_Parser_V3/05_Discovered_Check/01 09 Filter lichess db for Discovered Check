,"\n","def getPiecePositions(piece_type, piece_color, _board):\n","    # Now let's find all the pieces of given type and their positions\n","\n","    positions = []\n","    for square in chess.SQUARES:\n","        piece = _board.piece_at(square)\n","        if piece is not None and piece.piece_type == piece_type and piece.color == piece_color:\n","\n","          # In python-chess, files are numbered from 0 to 7 (where 0 corresponds to the 'a' file and 7 corresponds to the 'h' file),\n","          # and ranks also range from 0 to 7 (with 0 being rank 1 and 7 being rank 8).\n","          # You can adjust these values if you need them to match standard chess notation.\n","\n","          x = int(chess.square_file(square))\n","          y = int(chess.square_rank(square))\n","\n","          positions.append({\"coord\":[x, y], \"square\":chess.square_name(square)})  # Store the position in algebraic notation\n","\n","    return positions\n","\n","def getPieceNameForType(piece_type):\n","  piece_name = 'unknown'\n","  piece_names = {\n","    chess.PAWN: \"Pawn\",\n","    chess.KNIGHT: \"Knight\",\n","    chess.BISHOP: \"Bishop\",\n","    chess.ROOK: \"Rook\",\n","    chess.QUEEN: \"Queen\",\n","    chess.KING: \"King\"\n","  }\n","\n","  return piece_names[piece_type]\n","\n","def getCheckingPieces():\n","  checking_pieces = []\n","\n","  # Check if the king is in check\n","  if board.is_check():\n","      # Get the list of checking moves (there can be more than one if double check)\n","      checking_squares = list(board.checkers())\n","\n","      # For each checking piece, identify its type and color\n","      for square in checking_squares:\n","          piece = board.piece_at(square)\n","          if piece:\n","              piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n","              piece_color = 'white' if piece.color == chess.WHITE else 'black'\n","\n","              # print(f\"Check by a {piece_color} {chess.piece_name(piece_type)} at square {chess.square_name(square)}\")\n","              checking_pieces.append({\"type\": piece_type,\n","                                      \"name\": getPieceNameForType(piece.piece_type),\n","                                      \"color\": piece_color,\n","                                      \"square\": chess.square_name(square)})\n","\n","      return checking_pieces\n","\n","  return []\n","  # print(\"The king is not in check.\")\n","\n","\n","# Load CSV file into a DataFrame\n","df = pd.read_csv(output_file)\n","df['DiscoveredCheck'] = False\n","df[\"DiscoveredAttack\"] = False\n","\n","df[\"OurDiscovery\"] = False\n","df[\"OpponentDiscovery\"] = False\n","\n","df[\"MatchDiscovAttack_DiscovCheck\"] = \"None\"\n","df['puzzle_ref'] = 'https://lichess.org/training/' + df['PuzzleId']\n","\n","# Process each row using itertuples\n","line=0\n","matched_lines=0\n","start_time = datetime.now()\n","\n","for row in df.itertuples(index=True):\n","    if (line % 100000) == 0:\n","      # Calculate the time delta\n","      time_delta = datetime.now() - start_time\n","      print(f\"{time_delta}: puzzles searched: {line} matches: {matched_lines}\")\n","\n","    # if df['PuzzleId'][line] != '7i5Ig':\n","    #  line = line + 1\n","    #  continue\n","    #\n","    # print(f\"DEBUG: PuzzleId: '7i5Ig'\")\n","\n","    moves_to_apply = df['Moves'][line].split()\n","    #-> '['f2g3', 'e6e7', 'b2b1', 'b3c1', 'b1c1', 'h6c1']'\n","\n","    # Print the board position\n","    #print(board)\n","    #display(board)\n","    #print('Making moves')\n","    # Load the position from the FEN string\n","\n","    board = chess.Board(df['FEN'][line])\n","\n","    discovered_check = False\n","    our_color = None\n","    our_discovery = False\n","    opponent_color = None\n","    opponent_discovery = False\n","\n","    # Apply each move to the board\n","    move_count = 0\n","    # san_moves = []\n","    # chess_moves = []\n","\n","    i = 0\n","    for move in moves_to_apply:\n","      i = i + 1\n","\n","      chess_move = chess.Move.from_uci(move)   # Get Move object from UCI string\n","      # sample chess_moves: 'e5f4', 'a2a1q', 'g5g4', 'a6a7'\n","\n","      # print(f\"DEBUG: \")\n","      # print(f\"DEBUG: Making a move:{chess_move}\")\n","      # print(f\"DEBUG: Legal Move:{chess_move in board.legal_moves}\")\n","\n","      # Check if the move is legal before making it\n","      if chess_move in board.legal_moves:\n","          # chess_moves.append(move)\n","          # Get the piece at the source square\n","          piece_moved = board.piece_at(chess_move.from_square)\n","          piece_moved_color = \"white\" if piece_moved.color == chess.WHITE else \"black\"\n","\n","          if i == 1:                            # Determine who plays what color\n","            opponent_color = piece_moved_color\n","\n","            if opponent_color == \"white\":\n","              our_color = \"black\"\n","            else:\n","              our_color = \"white\"\n","\n","          # san_move = board.variation_san([chess_move])\n","          # san_moves.append(san_move)      # Remember the sequence of SAN moves\n","          # san_move: Bxg3, Rxe7, Qb1+, Nc1, Qxc1+, Qxc1, Qd6, Rd8, Qxd8+\n","\n","\n","          board.push(chess_move)  # Make the move to evaluate current position\n","\n","          checking_pieces = getCheckingPieces()\n","          # print(f\"DEBUG: checking_pieces:{checking_pieces}\")\n","          if len(checking_pieces) > 0:\n","            # BishopQueenRook = []\n","\n","            # Source and destination squares in algebraic notation\n","            source_square = chess.square_name(chess_move.from_square)\n","            destination_square = chess.square_name(chess_move.to_square)\n","\n","            for checking_piece in checking_pieces:\n","\n","              # print(f\"DEBUG: moves_to_apply:{moves_to_apply}, chess_moves: '{chess_moves}', san_moves: {san_moves}\")\n","              # print(f\"DEBUG: checking_piece:{checking_piece}\