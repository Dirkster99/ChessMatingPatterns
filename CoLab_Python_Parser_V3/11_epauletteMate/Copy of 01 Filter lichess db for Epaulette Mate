ns\n","    positions = []\n","\n","    for square in chess.SQUARES:\n","        piece = board.piece_at(square)\n","        if piece is not None and piece.piece_type == piece_type and piece.color == piece_color:\n","          # In python-chess, files are numbered from 0 to 7 (where 0 corresponds to the 'a' file and 7 corresponds to the 'h' file),\n","          # and ranks also range from 0 to 7 (with 0 being rank 1 and 7 being rank 8).\n","          # You can adjust these values if you need them to match standard chess notation.\n","          x = int(chess.square_file(square))\n","          y = int(chess.square_rank(square))\n","          positions.append({\"coord\":[x, y], \"square\":chess.square_name(square)})  # Store the position in algebraic notation\n","\n","    return positions\n","\n","def getPieceNameForType(piece_type):\n","  piece_name = 'unknown'\n","  piece_names = {\n","    chess.PAWN: \"Pawn\",\n","    chess.KNIGHT: \"Knight\",\n","    chess.BISHOP: \"Bishop\",\n","    chess.ROOK: \"Rook\",\n","    chess.QUEEN: \"Queen\",\n","    chess.KING: \"King\"\n","  }\n","\n","  return piece_names[piece_type]\n","\n","def getCheckingPieces():\n","  checking_pieces = []\n","\n","  # Check if the king is in check\n","  if board.is_check():\n","      # Get the list of checking moves (there can be more than one if double check)\n","      checking_squares = list(board.checkers())\n","\n","      # For each checking piece, identify its type and color\n","      for square in checking_squares:\n","          piece = board.piece_at(square)\n","          if piece:\n","              piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n","              piece_color = 'white' if piece.color == chess.WHITE else 'black'\n","\n","              x = int(chess.square_file(square))\n","              y = int(chess.square_rank(square))\n","\n","              # print(f\"Check by a {piece_color} {chess.piece_name(piece_type)} at square {chess.square_name(square)}\")\n","              checking_pieces.append({\"type\": piece_type,\n","                                      \"name\": getPieceNameForType(piece.piece_type),\n","                                      \"color\": piece_color,\n","                                      \"square\": chess.square_name(square),\n","                                      \"coord\": [x, y]})\n","\n","      return checking_pieces\n","\n","  return []\n","\n","\n","def getPieceAt(x:int, y:int):\n","\n","  square = chess.square(x, y)\n","  piece = board.piece_at(square)\n","  if piece:\n","      piece_type = piece.piece_type  # e.g., chess.BISHOP, chess.QUEEN\n","\n","      piece_color = 'white' if piece.color == chess.WHITE else 'black'\n","\n","      # print(f\"Check by a {piece_color} {chess.piece_name(piece_type)} at square {chess.square_name(square)}\")\n","      return({\"type\": piece_type,\n","              \"name\": getPieceNameForType(piece.piece_type),\n","              \"color\": piece_color,\n","              \"square\": chess.square_name(square),\n","              \"coord\": [x, y]})\n","\n","  return None\n","\n","\n","def is_square_light(square):\n","  \"\"\"\n","    Determine if a square on a chessboard is light or dark.\n","\n","    Usage:\n","    # Example usage\n","    square_a1 = chess.square(0, 0)  # a1\n","    square_h3 = chess.square(7, 2)  # h3\n","    print(is_square_light(square_a1))  # Output: False (dark)\n","    print(is_square_light(square_h3))  # Output: True (light)\n","  \"\"\"\n","  # Convert square to numeric values\n","  column = chess.square_file(square) + 1  # Convert to 1-8\n","  row = chess.square_rank(square) + 1      # Convert to 1-8\n","  return (column + row) % 2 == 1  # True for light, False for dark\n","\n","\n","def get_surrounding_empty_squares(king, _board):\n","    surrounding_squares = []\n","\n","    # Calculate the coordinates of the surrounding squares\n","    for dx in [-1, 0, 1]:\n","        for dy in [-1, 0, 1]:\n","            if (dx != 0 or dy 